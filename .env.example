# Copie para .env e preencha. O .env já está no .gitignore.
# NUNCA commite este arquivo preenchido. Credencial mora só no .env local.

# --- Django (opcional; sem DJANGO_SECRET_KEY o app gera .django-secret) ---
# Em uso real, desligue o modo debug.
#DJANGO_DEBUG=1
# Hosts além de localhost. Para o celular, inclua o IP da máquina (P2-9).
#DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Produção no PythonAnywhere (fase 8) ---
# No servidor, o .env leva estas três linhas (sem segredo: a chave sai do .django-secret).
#DJANGO_DEBUG=0
#DJANGO_ALLOWED_HOSTS=SEU_USUARIO.pythonanywhere.com
#DJANGO_CSRF_TRUSTED_ORIGINS=https://SEU_USUARIO.pythonanywhere.com

# --- Pluggy / Open Finance (fase 7) ---
# Credenciais da aplicação no dashboard da Pluggy (P2-12).
#PLUGGY_CLIENT_ID=
#PLUGGY_CLIENT_SECRET=
# Id da conexão do banco no Meu Pluggy (a mesma para todas as contas do item).
#PLUGGY_ITEM_ID=
