# Copie para .env e preencha. O .env já está no .gitignore.
# NUNCA commite este arquivo preenchido. Credencial mora só no .env local.

# sandbox | producao
INTER_AMBIENTE=sandbox

INTER_CLIENT_ID=
INTER_CLIENT_SECRET=

# Certificado e chave em PEM, guardados FORA do repositório.
# Use caminho absoluto do WSL, por exemplo:
# /home/vinicius/segredos/inter/inter.crt e /home/vinicius/segredos/inter/inter.key
INTER_CERT_PATH=
INTER_KEY_PATH=

# Número da conta corrente, só dígitos. Exigido pelos endpoints bancários.
INTER_CONTA_CORRENTE=
